  "dialogues": {
    "intro": {
      "speaker": "harpreet",
      "text": "The blue signal worked. Kabir’s last train arrived at North Bridge. But he never came through the exit. His carriage is empty. Let’s find out why."
    },
    "saveResume": {
      "speaker": "harpreet",
      "text": "We still need to find Kabir. The answer must be somewhere in the station."
    },
    "notice": {
      "speaker": "harpreet",
      "text": "The after-hours board lists three doors: 12 past midnight for the northbound stair, 17 past for the service passage, and 21 past for the freight yard."
    },
    "meena": {
      "speaker": "meena",
      "text": "I heard three knocks behind the station wall just as the lights went out. Then I saw a small lantern glow near the service control door. Kabir might have followed it."
    },
    "meenaRepeat": {
      "speaker": "meena",
      "text": "Those knocks came from the service passage, not the northbound stairs. Find out how to open it."
    },
    "note": {
      "speaker": "harpreet",
      "text": "A note from Kabir! 'I heard someone calling near the service passage. The old clock stopped at seventeen past midnight. I’m checking on them. — K'"
    },
    "noteAgain": {
      "speaker": "harpreet",
      "text": "Kabir wrote that the old clock stopped at seventeen past midnight. We should keep that in mind."
    },
    "foundToken": {
      "speaker": "harpreet",
      "text": "A brass token rolled beneath seat seven. It has the North Bridge crest. Maybe it fits a lock in the service control room."
    },
    "locked": {
      "speaker": "harpreet",
      "text": "The control panel has a round brass slot. We need something shaped like a station token."
    },
    "opened": {
      "speaker": "harpreet",
      "text": "That did it. The panel lights up, and three time settings are available."
    },
    "openedAgain": {
      "speaker": "harpreet",
      "text": "The panel is unlocked. Now we can route the power to the right passage."
    },
    "dead": {
      "speaker": "harpreet",
      "text": "The time selector is dead. The brass lock on the panel must be opened first."
    },
    "unknown": {
      "speaker": "harpreet",
      "text": "We need the passage board, Kabir’s note, and Meena’s account before touching this switch."
    },
    "choose": {
      "speaker": "harpreet",
      "text": "Kabir went toward the service passage. Which time on the board sends power to that door?",
      "choices": [
        {
          "label": "00:12 · Northbound stairs",
          "event": "time:0012"
        },
        {
          "label": "00:17 · Service passage",
          "event": "time:0017"
        },
        {
          "label": "00:21 · Freight yard",
          "event": "time:0021"
        }
      ]
    },
    "retry": {
      "speaker": "harpreet",
      "text": "That setting opens a different passage. Match Kabir’s note to the after-hours board.",
      "choices": [
        {
          "label": "00:12 · Northbound stairs",
          "event": "time:0012"
        },
        {
          "label": "00:17 · Service passage",
          "event": "time:0017"
        },
        {
          "label": "00:21 · Freight yard",
          "event": "time:0021"
        }
      ]
    },
    "cantCombine": {
      "speaker": "harpreet",
      "text": "The brass token belongs in the round lock on the service control panel."
    },
    "rescue": {
      "speaker": "kabir",
      "text": "Harpreet! I heard the night attendant calling for help and went through the service door. The power failed and trapped us both. You opened it!"
    },
    "relief": {
      "speaker": "meena",
      "text": "We brought the last train safely to North Bridge. Now we’ve brought its last passengers home. Nice detective work."
    },
    "epilogue": {
      "speaker": "harpreet",
      "text": "Case closed. But why did the old clock stop at exactly seventeen past midnight? That’s a mystery for another night."
    }
  },
  "objectives": [
    {
      "text": "Look for clues at North Bridge Station.",
      "if": "!readBoard"
    },
    {
      "text": "Ask Meena what happened when the train arrived.",
      "if": "!interviewed"
    },
    {
      "text": "Find out what Kabir left in Carriage Seven.",
      "if": "!readNote"
    },
    {
      "text": "Find a way to unlock the service control panel.",
      "if": "!unlocked"
    },
    {
      "text": "Set the correct time to open the service passage.",
      "if": ""
    }
  ],
  "hints": [
    {
      "text": "Inspect the after-hours passage board at North Bridge Station.",
      "if": "!readBoard"
    },
    {
      "text": "Ask Meena what she heard when the lights went out.",
      "if": "!interviewed"
    },
    {
      "text": "Kabir left a folded note on his seat in Carriage Seven.",
      "if": "!readNote"
    },
    {
      "text": "Look beneath the seat in Carriage Seven for a brass token.",
      "if": "!unlocked+!inventory.token"
    },
    {
      "text": "Select the brass token in your pocket, then tap the control panel.",
      "if": "!unlocked"
    },
    {
      "text": "The note says seventeen past midnight. Match that time to the station board.",
      "if": ""
    }
  ],
