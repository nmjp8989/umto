  "dialogues": {
    "intro": {
      "speaker": "kabir",
      "text": "The house knocked. The clock just sneezed. If the well burps, I’m going home."
    },
    "brief": {
      "speaker": "harpreet",
      "text": "Baldev is safe. Find what pulled his door shut and where the village register went."
    },
    "baldev": {
      "speaker": "baldev",
      "text": "I moved the register to the blue drum upstairs to keep it dry. When I came back down, a gust tugged something and my door latched shut."
    },
    "print": {
      "speaker": "harpreet",
      "text": "A star pressed into the wax, right beside a strand of pink string. Whatever made it pulled the latch tight."
    },
    "needPrint": {
      "speaker": "kabir",
      "text": "Wait. Something left a mark beside the latch. Check it before we go."
    },
    "meher": {
      "speaker": "meher",
      "text": "I saw a monster with wings! Then lightning lit it up. It was a kite with a pink tail, flying toward the clock tower."
    },
    "rohan": {
      "speaker": "rohan",
      "text": "I left my star-shaped reel by Baldev’s door. The wind snatched the kite, and the pink string whipped right into the crack by the latch."
    },
    "needFriends": {
      "speaker": "kabir",
      "text": "Meher saw the shadow. Rohan knows the string. Let’s hear both before climbing the tower."
    },
    "bell": {
      "speaker": "meher",
      "text": "Achoo! The kite tail is tickling the bell and shaking dust out of it. There’s your sneezing clock."
    },
    "reel": {
      "speaker": "rohan",
      "text": "My reel! The star matches the wax mark. Look, the pink string runs back down through the old signal pipe."
    },
    "crate": {
      "speaker": "harpreet",
      "text": "Blue paint. A dry lid. There’s a little paper corner peeking out."
    },
    "needTower": {
      "speaker": "kabir",
      "text": "Check the dusty bell, the reel and the blue drum. Then tell me which one is hiding the book."
    },
    "choose": {
      "speaker": "kabir",
      "text": "Detectives, where did Baldev put the register?",
      "choices": [
        {
          "label": "Inside the dusty bell",
          "event": "answer:bell"
        },
        {
          "label": "Behind the kite reel",
          "event": "answer:reel"
        },
        {
          "label": "Inside the blue drum",
          "event": "answer:drum"
        }
      ]
    },
    "retryBell": {
      "speaker": "meher",
      "text": "The bell has plenty of dust. What colour did Baldev say to look for?",
      "choices": [
        {
          "label": "Try again",
          "event": "click:solve"
        }
      ]
    },
    "retryReel": {
      "speaker": "rohan",
      "text": "The reel tells us what pulled the latch. What did Baldev use to keep the book dry?",
      "choices": [
        {
          "label": "Try again",
          "event": "click:solve"
        }
      ]
    },
    "found": {
      "speaker": "kabir",
      "text": "Village register, found! It’s so dry I can still smell the pencil."
    },
    "solved": {
      "speaker": "harpreet",
      "text": "The wind yanked the kite string. The star reel hit the wax, the string swung the door shut, and Baldev’s latch clicked on its own."
    },
    "laugh": {
      "speaker": "meher",
      "text": "Case closed. Can someone get the clock a tissue?"
    },
    "tease": {
      "speaker": "kabir",
      "text": "Hang on. The last page says “Tomorrow, 12:17. Bring one very small umbrella.” Who’s that for?"
    },
    "saveResume": {
      "speaker": "kabir",
      "text": "Ready, detective? Let’s pick up where we left off."
    },
    "cantCombine": {
      "speaker": "kabir",
      "text": "Tap a clue to look at it up close."
    },
    "chooseCause": {
      "speaker": "harpreet",
      "text": "You found the register. Now fit the clues together. What pulled Baldev’s door shut?",
      "choices": [
        {
          "label": "The wind tugged the kite string",
          "event": "cause:kite"
        },
        {
          "label": "The clock bell shook it shut",
          "event": "cause:bell"
        },
        {
          "label": "A monster pulled the latch",
          "event": "cause:monster"
        }
      ]
    },
    "retryCause": {
      "speaker": "meher",
      "text": "The shadow had a pink tail. What connects that tail to the star mark by the latch?",
      "choices": [
        {
          "label": "Try again",
          "event": "click:solve"
        }
      ]
    }
  },
