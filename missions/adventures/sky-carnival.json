  "dialogues": {
    "intro": {
      "speaker": "kabir",
      "text": "Emergency! The giant carnival balloon escaped with the birthday cake! It has a better seat than I do."
    },
    "shock": {
      "speaker": "meher",
      "text": "We have to save it before the candles become shooting stars. Look! The wind is blowing east."
    },
    "banner": {
      "speaker": "baldev",
      "text": "Today's programme: music at noon, cake at one. Please do not launch the cake into outer space."
    },
    "kabir": {
      "speaker": "kabir",
      "text": "The cake is still safe in the basket. If we repair our spare balloon, we can catch up."
    },
    "meher": {
      "speaker": "meher",
      "text": "The flags are pointing east. A gentle east breeze is perfect; a wild gust will flip us."
    },
    "baldev": {
      "speaker": "baldev",
      "text": "I was watching the balloon. Then I sneezed and it stole the entire cake! Even the cherry."
    },
    "workshopWelcome": {
      "speaker": "meena",
      "text": "Welcome to my invention tent. Take a patch and safety rope, then tune the fan gently."
    },
    "meena": {
      "speaker": "meena",
      "text": "Safety first! A good repair, a strong rope, and a gentle fan. No shortcuts."
    },
    "rohan": {
      "speaker": "rohan",
      "text": "I made a fan with three settings. Soft breeze, giant gust, and absolutely nothing."
    },
    "fabric": {
      "speaker": "rohan",
      "text": "Brilliant pink fabric! This will fix the tear in our rescue balloon."
    },
    "rope": {
      "speaker": "meena",
      "text": "A proper safety rope. Attach it before the balloon lifts, or we'll be chasing another one."
    },
    "fanQuestion": {
      "speaker": "rohan",
      "text": "What fan setting makes a calm, safe balloon launch?",
      "choices": [
        {
          "label": "Gentle breeze",
          "event": "fan:gentle"
        },
        {
          "label": "Super-hurricane blast!",
          "event": "fan:storm"
        },
        {
          "label": "Switch the fan off",
          "event": "fan:off"
        }
      ]
    },
    "fanRetry": {
      "speaker": "meena",
      "text": "That won't give us a steady launch. Pick the gentle breeze.",
      "choices": [
        {
          "label": "Try the gentle setting",
          "event": "fan:gentle"
        },
        {
          "label": "Try a giant gust again",
          "event": "fan:storm"
        }
      ]
    },
    "fanDone": {
      "speaker": "rohan",
      "text": "Perfect! The fan purrs like a sleepy kitten. And nobody lost their eyebrows."
    },
    "needParts": {
      "speaker": "harpreet",
      "text": "We need a patch, safety rope and a tuned fan. Visit Meena's repair tent."
    },
    "readyForField": {
      "speaker": "harpreet",
      "text": "Great teamwork! We've got the fabric, rope and fan ready. Let's head to the launch field."
    },
    "launchIntro": {
      "speaker": "kabir",
      "text": "Big balloon. Tiny basket. I vote we check every safety step before takeoff."
    },
    "needPatch": {
      "speaker": "meena",
      "text": "The balloon has a tear. Use the pink patch from your pocket on the balloon.",
      "choices": [
        {
          "label": "Attach the patch",
          "event": "drop:fabric:balloon"
        }
      ]
    },
    "patched": {
      "speaker": "meena",
      "text": "Patch secured. That's one less hole between us and the clouds."
    },
    "needRope": {
      "speaker": "rohan",
      "text": "Now fasten the safety rope! Tap it in your pocket, then tap the balloon.",
      "choices": [
        {
          "label": "Tie the safety rope",
          "event": "drop:rope:balloon"
        }
      ]
    },
    "tethered": {
      "speaker": "rohan",
      "text": "Tied tight! That knot could hold Baldev's whole tea collection."
    },
    "chooseWind": {
      "speaker": "meher",
      "text": "Which wind will carry us steadily toward the cake?",
      "choices": [
        {
          "label": "Gentle east wind",
          "event": "wind:east"
        },
        {
          "label": "Strong west gust",
          "event": "wind:west"
        },
        {
          "label": "Swirling wind from every direction",
          "event": "wind:swirl"
        }
      ]
    },
    "windRetry": {
      "speaker": "meher",
      "text": "Watch the carnival flags. They point east, so the safe breeze is east.",
      "choices": [
        {
          "label": "Choose east",
          "event": "wind:east"
        },
        {
          "label": "Try west",
          "event": "wind:west"
        }
      ]
    },
    "windDone": {
      "speaker": "meher",
      "text": "East wind confirmed. A beautiful day for a sky-high cake delivery."
    },
    "boardHint": {
      "speaker": "harpreet",
      "text": "Balloon repaired, rope attached and gentle east wind selected. All aboard!"
    },
    "launch": {
      "speaker": "kabir",
      "text": "We're flying! Please tell the ground I left my sandwich in the workshop."
    },
    "skyIntro": {
      "speaker": "meher",
      "text": "Whoa! Look at those rainbow clouds. And the runaway cake is right beside us!"
    },
    "skyKabir": {
      "speaker": "kabir",
      "text": "We must catch it gently. I can reach the basket using our safety rope."
    },
    "cloud": {
      "speaker": "meher",
      "text": "That cloud looks like a giant doughnut. I think I'm hungry."
    },
    "netHint": {
      "speaker": "meena",
      "text": "We can hold our rescue net under the cake. First, secure its basket with the rope."
    },
    "cakeChoice": {
      "speaker": "kabir",
      "text": "How should we catch the cake without dropping it?",
      "choices": [
        {
          "label": "Hook the safety rope to the basket",
          "event": "catch:rope"
        },
        {
          "label": "Jump out and grab the cake",
          "event": "catch:jump"
        },
        {
          "label": "Shake the balloon wildly",
          "event": "catch:shake"
        }
      ]
    },
    "cakeRetry": {
      "speaker": "harpreet",
      "text": "Safe rescuers stay in their balloon. Use the rope to pull the other basket close.",
      "choices": [
        {
          "label": "Use our safety rope",
          "event": "catch:rope"
        },
        {
          "label": "Jump anyway",
          "event": "catch:jump"
        }
      ]
    },
    "cakeCaught": {
      "speaker": "meena",
      "text": "Got it! Cake secured in the rescue net. Not a single cherry lost."
    },
    "needCake": {
      "speaker": "kabir",
      "text": "Not yet! We can't go home without the cake. Tap the runaway basket first."
    },
    "finalHero": {
      "speaker": "harpreet",
      "text": "Mission complete! Today we proved teamwork is stronger than the wind."
    },
    "finalMeher": {
      "speaker": "meher",
      "text": "Best cake delivery ever. It came with a free flight!"
    },
    "finalKabir": {
      "speaker": "kabir",
      "text": "Can I have the first slice? I've been emotionally supporting that cake for miles."
    },
    "finalBaldev": {
      "speaker": "baldev",
      "text": "Nobody touch the candles. I sneezed once and nearly sent the icing to the moon!"
    },
    "saveResume": {
      "speaker": "kabir",
      "text": "Welcome back, pilot. Our flying cake still needs you."
    },
    "cantCombine": {
      "speaker": "meena",
      "text": "Try attaching the patch or rope to the rescue balloon. Other items won't stick."
    }
  },
