  "objectives": [
    {
      "if": "!inventory.fabric+!patched",
      "text": "Collect the repair patch in Meena's tent."
    },
    {
      "if": "!inventory.rope+!tethered",
      "text": "Collect the safety rope in the tent."
    },
    {
      "if": "!fanFixed",
      "text": "Tune Rohan's fan to a gentle breeze."
    },
