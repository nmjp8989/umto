  "dialogues": {
    "intro": {
      "speaker": "harpreet",
      "text": "That horn is the last ferry. The lighthouse is dark, and the fog is closing in. Let’s get the beacon working."
    },
    "saveResume": {
      "speaker": "harpreet",
      "text": "The ferry is still out there. Let’s pick up where we left off."
    },
    "notice": {
      "speaker": "harpreet",
      "text": "The chart shows one steady light for the inner harbour, two flashes for the deep channel, and three flashes for the shoals."
    },
    "ticket": {
      "speaker": "kabir",
      "text": "I heard the captain on the radio. They need the deep channel. The ferry is too big for the inner harbour."
    },
    "repair": {
      "speaker": "meena",
      "text": "The old lens cracked in the storm. Take the spare from my workbench and fit it into the mount upstairs."
    },
    "repaired": {
      "speaker": "meena",
      "text": "The lens is fitted. Now you can set the signal dial."
    },
    "foundLens": {
      "speaker": "harpreet",
      "text": "A spare lens. Let’s get it to the lantern room."
    },
    "dead": {
      "speaker": "harpreet",
      "text": "The beacon needs a lens before I can set the signal."
    },
    "unknown": {
      "speaker": "harpreet",
      "text": "I need both clues. The chart shows the signals, and Kabir knows where the ferry is headed."
    },
    "choose": {
      "speaker": "harpreet",
      "text": "The ferry needs the deep channel. Which signal marks it on the chart?",
      "choices": [
        {
          "label": "One steady light",
          "event": "signal:steady"
        },
        {
          "label": "Two flashes",
          "event": "signal:double"
        },
        {
          "label": "Three flashes",
          "event": "signal:triple"
        }
      ]
    },
    "retry": {
      "speaker": "harpreet",
      "text": "That signal leads somewhere else. Check the flash pattern for the deep channel.",
      "choices": [
        {
          "label": "One steady light",
          "event": "signal:steady"
        },
        {
          "label": "Two flashes",
          "event": "signal:double"
        },
        {
          "label": "Three flashes",
          "event": "signal:triple"
        }
      ]
    },
    "cantCombine": {
      "speaker": "harpreet",
      "text": "The spare lens belongs in the circular mount in the lantern room."
    },
    "ferrySafe": {
      "speaker": "meena",
      "text": "The captain sees our two flashes. The ferry is through the deep channel."
    },
    "thanks": {
      "speaker": "kabir",
      "text": "Look at all those lights on the water! I can see the ferry from here."
    }
  },
  "objectives": [
    {
      "text": "Repair the lighthouse with the spare lens.",
      "if": "!lensFitted"
    },
    {
      "text": "Ask Kabir which route the ferry needs.",
      "if": "!destination"
    },
    {
      "text": "Read the channel chart on the harbour pier.",
      "if": "!readNotice"
    },
    {
      "text": "Set the signal dial in the lantern room.",
      "if": ""
    }
  ],
  "hints": [
    {
      "text": "Find the spare lens on Meena’s workshop bench.",
      "if": "!lensFitted+!inventory.lens"
    },
    {
      "text": "Select the lens in your pocket and tap the circular mount upstairs.",
      "if": "!lensFitted"
    },
    {
      "text": "Talk to Kabir on the harbour pier.",
      "if": "!destination"
    },
    {
      "text": "Read the framed channel chart on the pier.",
      "if": "!readNotice"
    },
    {
      "text": "Match the deep channel to its light pattern at the dial.",
      "if": ""
    }
  ],
  "rules": [
    {
      "when": "click:notice",
      "actions": [
        "flag:readNotice",
        "message:notice"
      ],
      "in": "home"
    },
    {
      "when": "click:kabir",
      "actions": [
        "flag:destination",
        "message:ticket"
      ],
      "in": "home"
    },
    {
      "when": "click:cross",
      "actions": [
        "scene:stall"
      ],
      "in": "home"
    },
    {
      "when": "click:back",
      "actions": [
        "scene:home"
      ],
      "in": "stall"
    },
    {
      "when": "click:platform",
      "actions": [
        "scene:platform"
      ],
      "in": "stall"
    },
    {
      "when": "click:cabin",
      "actions": [
        "scene:stall"
      ],
      "in": "platform"
    },
    {
      "when": "click:lens",
      "actions": [
        "inventory:lens",
        "sound:click",
        "message:foundLens"
      ],
      "in": "stall",
      "if": "!inventory.lens+!lensFitted"
    },
    {
      "when": "click:meena",
      "actions": [
        "message:repaired"
      ],
      "in": "stall",
      "if": "lensFitted"
    },
    {
      "when": "click:meena",
      "actions": [
        "message:repair"
      ],
      "in": "stall"
    },
    {
      "when": "click:panel",
      "actions": [
        "message:repaired"
      ],
      "in": "platform",
      "if": "lensFitted"
    },
    {
      "when": "click:panel",
      "actions": [
        "message:repair"
      ],
      "in": "platform"
    },
    {
      "when": "drop:lens:panel",
      "actions": [
        "remove:lens",
        "flag:lensFitted",
        "sound:click",
        "message:repaired"
      ],
      "in": "platform",
      "if": "inventory.lens+!lensFitted"
    },
    {
      "when": "click:lever",
      "actions": [
        "message:dead"
      ],
      "in": "platform",
      "if": "!lensFitted"
    },
    {
      "when": "click:lever",
      "actions": [
        "message:choose"
      ],
      "in": "platform",
      "if": "lensFitted+destination+readNotice"
    },
    {
      "when": "click:lever",
      "actions": [
        "message:unknown"
      ],
      "in": "platform"
    },
    {
      "when": "signal:steady",
      "actions": [
        "message:retry"
      ],
      "in": "platform",
      "if": "lensFitted+destination+readNotice"
    },
    {
      "when": "signal:triple",
      "actions": [
        "message:retry"
      ],
      "in": "platform",
      "if": "lensFitted+destination+readNotice"
    },
    {
      "when": "signal:double",
      "actions": [
        "flag:signalSet",
        "ending:arrival",
        "sequence:arrival"
      ],
      "in": "platform",
      "if": "lensFitted+destination+readNotice+!signalSet"
    }
  ],
