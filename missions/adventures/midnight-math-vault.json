  "puzzles": {
    "rounding": {
      "type": "rounding",
      "title": "The Rounding Dial",
      "instruction": "Round 3,472 to the nearest hundred.",
      "start": 3300,
      "end": 3700,
      "step": 100,
      "correct": 3500,
      "hint": "Look at the tens digit: 7 is five or more, so round 3,400 up."
    },
