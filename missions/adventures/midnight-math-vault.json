  "hints": [
    {
      "if": "!rounded",
      "text": "Round 3,472 to the nearest hundred. The tens digit is 7, so choose 3,500 on the dial."
    },
    {
      "if": "!patternDone",
      "text": "In the corridor, the sequence increases by six each time. Add six to thirty."
    },
    {
      "if": "!arrayDone",
      "text": "There are seven rows of eight: multiply 7 × 8, or add eight seven times."
    },
    {
      "if": "!fractionsDone",
      "text": "To find three quarters of twelve, divide twelve by four, then multiply by three."
    },
    {
      "if": "!perimeterDone",
      "text": "For the rectangle's perimeter, add the lengths of all four sides: 7+5+7+5."
    },
    {
      "if": "scene.vault",
      "text": "Tap the glowing time capsule to complete the mission."
    },
    {
      "text": "Explore each glowing object to find the next clue."
    }
  ],
  "completionObjective": "The secret time capsule has been recovered."
}
