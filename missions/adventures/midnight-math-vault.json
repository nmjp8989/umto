      "hint": "Add all four sides: 7 + 5 + 7 + 5."
    }
  },
  "dialogues": {
    "intro": {
      "speaker": "harpreet",
      "text": "Someone left a note at the old school. Its clock started ringing at midnight, even though it has been silent for years."
    },
    "kabirIntro": {
      "speaker": "kabir",
      "text": "I hear a ticking sound. Five math locks guard a hidden time capsule. And apparently I'm the only one who brought a pencil."
    },
    "note": {
      "speaker": "kabir",
      "text": "The chalk says: 'Round the number on the gate. Find the pattern. Count the tiles. Share the light. Measure the room.' Five locks!"
    },
    "baldev": {
      "speaker": "baldev",
      "text": "I was the caretaker. We buried a time capsule long ago. The school clock only wakes up when clever young detectives arrive."
    },
    "kabir": {
      "speaker": "kabir",
      "text": "I'll check for secret clues while you solve the puzzles. You can always ask for a hint."
    },
    "gateQuestion": {
      "speaker": "kabir",
      "text": "The gate has a rounding dial. Move it to the nearest hundred, then test your answer.",
      "puzzle": "rounding",
      "choices": [
        {
          "label": "Unlock mechanism",
          "event": "solve:rounding"
        }
      ]
    },
    "gateOpened": {
      "speaker": "baldev",
      "text": "The gate opened! You rounded 3,472 to 3,500. That's one lock down."
    },
    "hallwayIntro": {
      "speaker": "meher",
      "text": "Welcome to the number corridor! The floor and the wall are connected. Solve both mini-games to open the classroom."
    },
    "meher": {
      "speaker": "meher",
      "text": "The wall numbers keep growing in a pattern. Figure out what is being added each time."
    },
    "rohan": {
      "speaker": "rohan",
      "text": "I built these glowing tiles. Each row must have the same number of squares. Count carefully!"
    },
    "patternQuestion": {
      "speaker": "meher",
      "text": "The numbers on the wall are blinking. Tap the missing number to keep the pattern going.",
      "puzzle": "pattern",
      "choices": [
        {
          "label": "Unlock mechanism",
          "event": "solve:pattern"
        }
      ]
    },
    "patternSolved": {
      "speaker": "meher",
      "text": "Yes! 12, 18, 24, 30, 36. Each step adds six. The wall lights are on."
    },
    "arrayQuestion": {
      "speaker": "rohan",
      "text": "Count the tiles in this rectangle. You can use multiplication or repeated addition.",
      "puzzle": "array",
      "choices": [
        {
          "label": "Unlock mechanism",
          "event": "solve:array"
        }
      ]
    },
    "arraySolved": {
      "speaker": "rohan",
      "text": "Seven groups of eight equals fifty-six tiles! The floor is glowing like a tiny disco."
    },
    "needHallway": {
      "speaker": "meher",
      "text": "The classroom is locked until the pattern wall AND the multiplication floor are fixed."
    },
    "classroomIntro": {
      "speaker": "meena",
      "text": "This is the hidden math laboratory. Choose the correct fraction of lanterns, then measure the vault's perimeter."
    },
    "labMeena": {
      "speaker": "meena",
      "text": "A quarter means one of four equal parts. For the vault's perimeter, count the entire distance around its edges."
    },
    "labKabir": {
      "speaker": "kabir",
      "text": "I found a blueprint and twelve lantern switches. They look like puzzles, not decorations."
    },
    "fractionQuestion": {
      "speaker": "meena",
      "text": "Tap the lantern switches until exactly three quarters of twelve are lit.",
      "puzzle": "fractions",
      "choices": [
        {
          "label": "Unlock mechanism",
          "event": "solve:fractions"
        }
      ]
    },
    "fractionSolved": {
      "speaker": "meena",
      "text": "Nine of twelve lanterns are on. Three quarters is the same as nine twelfths. Beautiful work!"
    },
    "perimeterQuestion": {
      "speaker": "harpreet",
      "text": "The blueprint shows a seven-metre by five-metre rectangle. What is the total distance around it?",
      "puzzle": "perimeter",
      "choices": [
        {
          "label": "Unlock mechanism",
          "event": "solve:perimeter"
        }
      ]
    },
    "perimeterSolved": {
      "speaker": "kabir",
      "text": "Twenty-four metres around! That is the perimeter. I wish our schoolwork opened real secret doors."
    },
    "needLab": {
      "speaker": "meena",
      "text": "We still need both the fraction switchboard and the perimeter blueprint."
    },
    "vaultIntro": {
      "speaker": "kabir",
      "text": "The last door just opened! That's the time capsule. Why is the clock pointing to twelve?"
    },
    "clock": {
      "speaker": "meher",
      "text": "The hands point to twelve. Maybe the clock was saving this exact moment for us."
    },
    "ready": {
      "speaker": "harpreet",
      "text": "All five locks are solved. Open the capsule and see what the old school wanted us to remember."
    },
    "finalKabir": {
      "speaker": "kabir",
      "text": "It's full of drawings from children who studied here years ago! One says: 'To the kids of the future—keep asking questions.'"
    },
    "finalMeher": {
      "speaker": "meher",
      "text": "Look! The missing clock hand is tucked inside the capsule with a note about friendship and curiosity."
    },
    "finalHarpreet": {
      "speaker": "harpreet",
      "text": "Case closed. We solved five Grade Four math puzzles, rescued a memory, and uncovered a story worth sharing."
    },
    "finalRohan": {
      "speaker": "rohan",
      "text": "The clock is ticking again! And my tiles are still glowing. Can we call it an educational disco?"
    },
    "saveResume": {
      "speaker": "kabir",
      "text": "Welcome back! The five math locks are still waiting for you."
    },
    "cantCombine": {
      "speaker": "harpreet",
      "text": "That object doesn't fit here. Explore the clues and solve each puzzle."
    }
  },
