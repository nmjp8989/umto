      "type": "pattern",
      "title": "The Number Trail",
      "instruction": "Complete the sequence: 12, 18, 24, 30, ___",
      "options": [
        32,
        34,
        36,
        38
      ],
      "correct": 36,
      "hint": "Each number goes up by 6."
    },
    "array": {
      "type": "array",
